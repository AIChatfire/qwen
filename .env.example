# qwen-service 配置模板 —— 复制为 .env 并填值（.env 已被 gitignore，凭据不落库）

# ---------- 上游 ----------
QWEN_BASE_URL=https://chat.qwen.ai
# 会话用的聊天模型（不是"视频模型"——上游没有视频模型这一层，见 docs/UPSTREAM.md §8）
QWEN_CHAT_MODEL=qwen3.7-plus
# QWEN_USER_AGENT=
# QWEN_VERSION_HEADER=0.2.0
# QWEN_UPSTREAM_TIMEOUT=60
# QWEN_TRUST_ENV=0

# ---------- 账号池 ----------
# 逗号分隔的 `email:password` 列表；密码相同可只留邮箱、统一写 QWEN_ACCOUNT_PASSWORD。
QWEN_ACCOUNTS=
QWEN_ACCOUNT_PASSWORD=
# 或每行一条（# 注释；密码含逗号时必须用文件形态）：
# QWEN_ACCOUNTS_FILE=/app/var/accounts.txt

# 可选：每账号附加 cookie 串（整份浏览器 jar，或 ssxmod_itna/acw_tc 等指纹 cookie）。
# 默认空 = 只发 `Cookie: token=<JWT>`（登录态最小凭据，实测 5/5 可用）
# QWEN_ACCOUNT_COOKIES={"a@x.cn": "整份浏览器 jar，或反爬指纹 cookie（键名见 reverse-proxy 文档）"}
# QWEN_ACCOUNT_COOKIES_FILE=/app/var/account_cookies.json

# ---------- token 铸造（signin 必须走轮换出口，直连会把出口打进 WAF 墙） ----------
QWEN_SIGNIN_SOCKS=
# 或改用外部 token 服务（image-adapter tools/token_service.py 同款接口）：
# QWEN_TOKEN_URL=http://172.19.0.1:8792/token
# QWEN_TOKEN_TTL=518400
# QWEN_SIGNIN_MIN_INTERVAL=45
# QWEN_SIGNIN_WAIT_TIMEOUT=45

# ---------- 节奏与额度 ----------
# QWEN_SUBMIT_MIN_INTERVAL=15
QWEN_DAILY_VIDEO_CAP=3
# QWEN_ACCOUNT_WAIT_TIMEOUT=30

# ---------- 对外鉴权（留空 = 关闭鉴权，仅限内网） ----------
API_KEYS=
# KEY_SECRET=

# ---------- 排队 / 重试（复用任务表，无独立队列组件；见 docs/INTERFACE.md §3.3） ----------
# 容量不足（账号全忙/冷却/额度尽）⇒ 落 queued 并立即返回 id，由协调器或后续 GET 出队提交。
# 只重试「可证明上游未受理」的失败；含义不明的失败（5xx/超时）绝不自动重试（防重复计费）。
# SUBMIT_QUEUE_ENABLED=1
# QUEUE_MAX_DEPTH=50
# SUBMIT_MAX_ATTEMPTS=5
# QUEUE_RETRY_BASE=30

# ---------- 任务持久化 ----------
# 默认 SQLite（单机够用）；多实例共享请换 PostgreSQL：
# TASK_DB=postgresql+psycopg2://qwen:qwen@db:5432/qwen
DATA_DIR=/app/var
# TASK_TIMEOUT=900
TASK_RETENTION_DAYS=7
# 后台协调器：出队 queued 任务 + 主动回查 + 过期清理（默认开；单 worker 部署）
COORDINATOR_ENABLED=1
# COORDINATOR_TICK=5

# ---------- 进程 ----------
HOST=0.0.0.0
PORT=8400
LOG_LEVEL=INFO
